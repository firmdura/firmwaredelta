{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "entries": {
      "type": "array",
      "maxItems": 250000,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "required": [
    "schema_version",
    "entries"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firmwaredelta.invalid/schemas/inventory-v1.json",
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^/\u0000]+(/[^/\u0000]+)*$",
      "not": {
        "pattern": "(^|/)\\.\\.?(/|$)"
      }
    },
    "entry": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "kind": {
          "enum": [
            "file",
            "directory",
            "symlink",
            "block_device",
            "char_device",
            "fifo",
            "socket"
          ]
        },
        "mode": {
          "type": "string",
          "pattern": "^[0-7]{4}$"
        },
        "category": {
          "enum": [
            "config",
            "library",
            "executable",
            "other"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "target": {
          "type": "string",
          "pattern": "^[^\u0000]*$"
        },
        "elf": {
          "type": "object",
          "properties": {
            "class": {
              "enum": [
                "32",
                "64"
              ]
            },
            "endian": {
              "enum": [
                "little",
                "big"
              ]
            },
            "machine": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "soname": {
              "type": "string",
              "pattern": "^[^\u0000]*$"
            },
            "needed": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[^\u0000]*$"
              },
              "uniqueItems": true
            }
          },
          "required": [
            "class",
            "endian",
            "machine",
            "soname",
            "needed"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "path",
        "kind",
        "mode",
        "category"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "file"
              }
            }
          },
          "then": {
            "required": [
              "size",
              "sha256"
            ],
            "not": {
              "required": [
                "target"
              ]
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "size"
                  ]
                },
                {
                  "required": [
                    "sha256"
                  ]
                },
                {
                  "required": [
                    "elf"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "symlink"
              }
            }
          },
          "then": {
            "required": [
              "target"
            ]
          },
          "else": {
            "not": {
              "required": [
                "target"
              ]
            }
          }
        }
      ]
    },
    "content": {
      "type": "object",
      "properties": {
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "size",
        "sha256"
      ],
      "additionalProperties": false
    }
  }
}
